PORT=5000
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/pedoderma?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=1d

# Cloudinary configuration
CLOUD_NAME=your_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# SMTP / Brevo configuration
SMTP_KEY=your_smtp_key_here
SMTP_LOGIN=your_smtp_login@smtp-brevo.com
SMTP_PORT=587
SMTP_SERVER=smtp-relay.brevo.com

MAIL_FROM=your_email@example.com
